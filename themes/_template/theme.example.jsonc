{
  // Theme v3 — copy to themes/<id>/theme.jsonc; set metadata.name = <id>.
  // Validate with specs/schemas/theme-v3.schema.json (JSONC-aware).
  //
  // tokens: arbitrary color names → #RRGGBBAA.
  // shim_assign: shared roles (specs/shim-colors.md) → token / hex / "transparent".
  // Targets: targets/<kitty|kvantum|albert>/mapping.jsonc (schema_version "2", shim_to_native).
  //
  // v2 canonical themes: theme.v2.example.jsonc. v1: theme.v1.legacy.jsonc.
  "metadata": {
    "schema_version": "3",
    "name": "replace-with-pack-directory-name",
    "version": "0.1.0"
  },
  "tokens": {
    "void": "#010212FF",
    "mist": "#1e1e2eFF",
    "foam": "#cdd6f4FF",
    "accent": "#89b4faFF"
  },
  "shim_assign": {
    "background": "void",
    "foreground": "foam",
    "cursor": "accent",
    "cursor_text": "void",
    "palette_0": "void",
    "palette_1": "void",
    "palette_2": "void",
    "palette_3": "void",
    "palette_4": "accent",
    "palette_5": "void",
    "palette_6": "foam",
    "palette_7": "foam",
    "palette_8": "mist",
    "palette_9": "void",
    "palette_10": "void",
    "palette_11": "void",
    "palette_12": "accent",
    "palette_13": "void",
    "palette_14": "foam",
    "palette_15": "foam",
    "window": "void",
    "base": "mist",
    "text": "foam",
    "chrome_focus": "accent"
  },
  "fonts": {
    "ui": { "family": "Inter" },
    "mono": { "family": "JetBrainsMono Nerd Font" }
  }
}
