{
  // Theme v2 — copy to themes/<id>/theme.jsonc; set metadata.name = <id>.
  // Validate with specs/schemas/theme-v2.schema.json (JSONC-aware).
  //
  // tokens: arbitrary color names → #RRGGBBAA only.
  // canonical_assign: maps stable keys (specs/canonical-colors.md) → token name or literal / "transparent".
  // Per-target projection: targets/<kitty|kvantum|albert>/mapping.jsonc (+ CHROMAMANCER_TARGETS_DIR).
  //
  // v1 (Base16-only + in-file targets): theme.v1.example.jsonc (legacy).
  "metadata": {
    "schema_version": "2",
    "name": "replace-with-pack-directory-name",
    "version": "0.1.0"
  },
  "tokens": {
    "void": "#010212FF",
    "mist": "#1e1e2eFF",
    "foam": "#cdd6f4FF",
    "accent": "#89b4faFF"
  },
  "canonical_assign": {
    "terminal.background": "void",
    "terminal.foreground": "foam",
    "terminal.cursor": "accent",
    "terminal.cursor_text": "void",
    "terminal.color0": "void",
    "terminal.color1": "void",
    "terminal.color2": "void",
    "terminal.color3": "void",
    "terminal.color4": "accent",
    "terminal.color5": "void",
    "terminal.color6": "foam",
    "terminal.color7": "foam",
    "terminal.color8": "mist",
    "terminal.color9": "void",
    "terminal.color10": "void",
    "terminal.color11": "void",
    "terminal.color12": "accent",
    "terminal.color13": "void",
    "terminal.color14": "foam",
    "terminal.color15": "foam",
    "qt.kvantum.window": "void",
    "qt.kvantum.base": "mist",
    "qt.kvantum.text": "foam",
    "qt.kvantum.highlight": "accent"
  },
  "fonts": {
    "ui": { "family": "Inter" },
    "mono": { "family": "JetBrainsMono Nerd Font" }
  }
}
