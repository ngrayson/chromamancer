{
  // Izar — theme v3. Ten swatches → shim_assign (see specs/shim-colors.md).
  // list_selection (teal) vs chrome_focus (blue): Kvantum highlight vs Albert row accent.
  "metadata": {
    "schema_version": "3",
    "name": "izar",
    "version": "0.3.0"
  },
  "tokens": {
    "void": "#010212FF",
    "depth": "#0B0A1CFF",
    "panel": "#202661FF",
    "plum": "#302947FF",
    "blue": "#405495FF",
    "lavender": "#D7CADCFF",
    "mint": "#DCF5E1FF",
    "mauve": "#A481CCFF",
    "teal": "#6ABAB5FF",
    "sage": "#8CCCA4FF"
  },
  "shim_assign": {
    "background": "void",
    "foreground": "lavender",
    "selection_background": "teal",
    "selection_foreground": "void",
    "cursor": "teal",
    "cursor_text": "void",
    "url": "teal",
    "palette_0": "void",
    "palette_1": "mauve",
    "palette_2": "teal",
    "palette_3": "teal",
    "palette_4": "sage",
    "palette_5": "blue",
    "palette_6": "lavender",
    "palette_7": "mint",
    "palette_8": "plum",
    "palette_9": "mauve",
    "palette_10": "teal",
    "palette_11": "teal",
    "palette_12": "sage",
    "palette_13": "blue",
    "palette_14": "lavender",
    "palette_15": "mint",
    "window": "void",
    "base": "depth",
    "alt_base": "panel",
    "button": "panel",
    "light": "depth",
    "mid_light": "depth",
    "dark": "plum",
    "mid": "panel",
    "chrome_focus": "blue",
    "chrome_focus_muted": "plum",
    "text": "lavender",
    "window_text": "lavender",
    "button_text": "lavender",
    "inactive_text": "blue",
    "disabled_text": "plum",
    "tooltip_base": "depth",
    "tooltip_text": "lavender",
    "chrome_focus_text": "lavender",
    "link": "teal",
    "link_visited": "mauve",
    "placeholder_text": "plum",
    "list_selection": "teal",
    "list_subtext": "teal",
    "list_selection_foreground": "void",
    "list_selection_subtext": "depth",
    "selection_border": "transparent"
  },
  "fonts": {
    "ui": { "family": "IosevkaTermSlab NFM" },
    "mono": { "family": "IosevkaTermSlab NFM" }
  }
}
