{
  // Kvantum: canonical → GeneralColors kvconfig keys (group GeneralColors only in v1)
  "metadata": {
    "schema_version": "1",
    "target_id": "kvantum",
    "comment": "Native value = key inside [GeneralColors], e.g. window.color"
  },
  "canonical_to_native": {
    "qt.kvantum.window": "window.color",
    "qt.kvantum.base": "base.color",
