{
  // Albert: shim → INI keys (section.key). Adapters emit [palette] / [window] from the prefix.
  "metadata": {
    "schema_version": "2",
    "target_id": "albert",
    "comment": "Native strings are section.key; array = same resolved color applied to each key."
  },
  "shim_to_native": {
    "base": ["palette.base", "window.input_background_brush"],
    "text": [
      "palette.text",
      "window.result_item_text_color",
      "window.action_item_text_color"
    ],
    "window": "palette.window",
    "window_text": "palette.window_text",
    "button": ["palette.button", "window.settings_button_color"],
    "button_text": "palette.button_text",
    "list_selection": [
      "palette.highlight",
      "window.input_border_brush",
      "window.input_trigger_color",
      "window.settings_button_highlight_color",
      "window.result_item_selection_background_brush",
      "window.action_item_selection_background_brush"
    ],
    "placeholder_text": ["palette.placeholder_text", "window.input_hint_color"],
    "link": "palette.link",
    "link_visited": "palette.link_visited",
    "selection_border": [
      "window.result_item_selection_border_brush",
      "window.action_item_selection_border_brush"
    ],
    "list_selection_foreground": [
      "palette.highlight_text",
      "window.result_item_selection_text_color",
      "window.action_item_selection_text_color"
    ],
    "list_selection_subtext": "window.result_item_selection_subtext_color",
    "list_subtext": "window.result_item_subtext_color"
  },
  "apply_nix": {
    "themes_dir": ".local/share/albert/widgetsboxmodel/themes",
    "theme_file_template": "{theme_id}.ini"
  }
}
