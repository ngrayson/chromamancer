{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localhost/chromamancer/theme-v1.schema.json",
  "title": "chromamancer theme v1",
  "description": "Validates the JSON value inside theme.jsonc. v1: schema_version, Base16 tokens, fonts, optional assets, optional targets (registered target ids only).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1",
          "description": "Theme document format version; must match this schema major revision."
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Theme id (kebab-case). When the pack lives at themes/<name>/, MUST equal the directory name (see SPEC.md)."
        },
        "version": {
          "type": "string",
          "description": "Theme pack authoring revision, not schema_version."
        },
        "author": { "type": "string" }
      },
      "required": ["schema_version", "name"]
    },
    "tokens": {
      "type": "object",
      "description": "Canonical Base16 palette. Keys base00..base0F; values #RRGGBBAA.",
      "additionalProperties": false,
      "properties": {
        "base00": { "$ref": "#/$defs/RgbaHex" },
        "base01": { "$ref": "#/$defs/RgbaHex" },
        "base02": { "$ref": "#/$defs/RgbaHex" },
        "base03": { "$ref": "#/$defs/RgbaHex" },
        "base04": { "$ref": "#/$defs/RgbaHex" },
        "base05": { "$ref": "#/$defs/RgbaHex" },
        "base06": { "$ref": "#/$defs/RgbaHex" },
        "base07": { "$ref": "#/$defs/RgbaHex" },
        "base08": { "$ref": "#/$defs/RgbaHex" },
        "base09": { "$ref": "#/$defs/RgbaHex" },
        "base0A": { "$ref": "#/$defs/RgbaHex" },
        "base0B": { "$ref": "#/$defs/RgbaHex" },
        "base0C": { "$ref": "#/$defs/RgbaHex" },
        "base0D": { "$ref": "#/$defs/RgbaHex" },
        "base0E": { "$ref": "#/$defs/RgbaHex" },
        "base0F": { "$ref": "#/$defs/RgbaHex" }
      },
      "required": [
        "base00",
        "base01",
        "base02",
        "base03",
        "base04",
        "base05",
        "base06",
        "base07",
        "base08",
        "base09",
        "base0A",
        "base0B",
        "base0C",
        "base0D",
        "base0E",
        "base0F"
      ]
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ui": { "$ref": "#/$defs/FontFamily" },
        "mono": { "$ref": "#/$defs/FontFamily" }
      },
      "required": ["ui", "mono"]
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wallpaper": { "type": "string" },
        "avatar": { "type": "string" }
      }
    },
    "targets": {
      "type": "object",
      "description": "Keys MUST be registered target ids (see SPEC.md / logic-registry.md). Bump schema when adding a target.",
      "propertyNames": {
        "enum": [
          "hyprland",
          "kitty",
          "gtk",
          "qt",
          "kvantum",
          "quickshell",
          "albert"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "mappings": {
            "type": "object",
            "additionalProperties": true
          },
          "apply_quick": {
            "type": "object",
            "additionalProperties": true
          },
          "apply_nix": {
            "type": "object",
            "additionalProperties": true
          },
          "logic": { "type": "string" },
          "overrides": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  },
  "required": ["metadata", "tokens", "fonts"],
  "$defs": {
    "RgbaHex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{8}$"
    },
    "FontFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family"],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
